# Required. One of development, test, production. Drives Swagger, log format, cookie default.
NODE_ENV=development
# Optional (default 4000). HTTP port.
PORT=4000
# Required. Database connection.
MONGODB_URI=mongodb://localhost:27018/auth_dev
# Required, at least 32 characters, no default. HS256 signing key. The example value is refused at boot; generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-64-random-hex-characters-0000000000000000000000000
# Optional (default 3600). Token lifetime and cookie Max-Age.
JWT_TTL_SECONDS=3600
# Required. Only allowed CORS origin.
WEB_ORIGIN=http://localhost:3000
# Optional (default true in production, false otherwise). Secure cookie flag; false is refused in production.
COOKIE_SECURE=false
# Optional (default 1). Proxy hops trusted when reading the client IP.
TRUST_PROXY_HOPS=1
# Optional (default 10). Requests per window on signup and signin.
THROTTLE_AUTH_LIMIT=10
# Optional (default 60). Rate-limit window.
THROTTLE_AUTH_TTL_SECONDS=60
# Optional (default info). Pino level.
LOG_LEVEL=info
# Tests only; not read by the running app. Database name must end in _test and differ from MONGODB_URI.
TEST_MONGODB_URI=mongodb://localhost:27018/auth_test
